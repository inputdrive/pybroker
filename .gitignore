# Python bytecode and tool caches.
# .mypy_cache and .ruff_cache also ship their own ignore files, but those
# appear only after the tool has already written the directory.
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.dmypy.json
.pytype/
.pytest_cache/
.hypothesis/
.tox/
.nox/
.numba_config.yaml

# Packaging and coverage.
build/
dist/
*.egg-info/
.eggs/
**/.coverage
**/.coverage.*
htmlcov/
coverage.xml

# Local environments and secrets.
# .venv* also covers .venv-bench and other checkout-local envs.
.venv*
.dev/
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# PyBroker and benchmark local state.
.pybrokercache
.asv/
.audit/

# Docs build output and notebook checkpoints.
docs/build
docs/_build/
.ipynb_checkpoints/
**/locales/*/LC_MESSAGES/*.mo

# Local backtest dumps. Tracked fixtures under tests/testdata and
# docs/source/notebooks/data stay committable.
/sample_data.csv
/equity_curve_*.csv
/benchmarks/wf_*.csv

# Editors and OS junk.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
